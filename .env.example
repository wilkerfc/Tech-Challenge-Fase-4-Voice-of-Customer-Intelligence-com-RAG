# O modo extrativo não requer chave. Para geração, exporte estas variáveis.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
# Backend local alternativo: LLM_BASE_URL=local, LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# Os modelos padrão têm revisões fixadas no código. Para outro LLM, opcional:
# LLM_REVISION=<commit-do-modelo-Hugging-Face>
VOC_CPU_THREADS=1
LLM_QUANTIZE=0
